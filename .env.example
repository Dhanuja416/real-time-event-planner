# ============================================================
# REAP — Environment Variables Template
# ============================================================
# Copy this file and rename to .env, then fill in your values.
# NEVER commit the .env file to source control.
# ============================================================

# --- Database ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=reapdb;Username=postgres;Password=YOUR_DB_PASSWORD

# --- JWT Authentication ---
JwtSettings__Key=YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS
JwtSettings__Issuer=REAP_API_Issuer
JwtSettings__Audience=REAP_API_Clients
JwtSettings__DurationInDays=7

# --- Email (SendGrid) ---
EmailSettings__SendGridApiKey=SG.YOUR_SENDGRID_API_KEY
EmailSettings__SenderEmail=your-email@example.com
EmailSettings__SenderName=REAP Support
EmailSettings__FrontendUrl=https://localhost:5173

# --- CORS ---
CorsSettings__AllowedOrigins__0=http://localhost:5173
CorsSettings__AllowedOrigins__1=https://localhost:5173
